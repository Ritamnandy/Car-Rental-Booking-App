# Application
PORT=3000
NODE_ENV=development
COR_ORIGIN=http://localhost:5173

# PostgreSQL (used by Prisma and docker-compose.yml)
POSTGRES_USER=postgres-user-name
POSTGRES_PASSWORD=postgres-password
POSTGRES_DB=postgres-db-name
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication — use long, unique random secrets in real environments.
JWT_SECRET=replace_with_a_long_random_access_token_secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=10d
FORGET_PASSWORD_URL=http://localhost:5173/forget-password

# Email (use a Gmail app password when using Gmail SMTP)
MAIL_USER=your-email@example.com
MAIL_PASSWORD=your-gmail-app-password
APP_EMAIL=your-email@example.com

# ImageKit
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id
